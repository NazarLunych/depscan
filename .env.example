# Claude API — required. Powers the per-package analysis (interprets hard
# facts into breaking changes, migration steps, and ROI).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Exa.ai API — required. Last-resort changelog search when a package has no
# usable GitHub Releases or CHANGELOG.md.
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# GitHub token — optional but recommended. Raises the GitHub API rate limit
# from 60 to 5000 req/h; without it the changelog cascade degrades to Exa
# once the limit is hit. A classic token with no scopes is enough (public repos only).
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
